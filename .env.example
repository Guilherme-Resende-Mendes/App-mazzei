# ==============================
# Application
# ==============================
NODE_ENV=development
PORT=3333
API_PREFIX=/api

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================
# Database (PostgreSQL)
# ==============================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://mazzei:mazzei@localhost:5432/mazzei?schema=public

# ==============================
# JWT / Auth
# ==============================
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-value
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt cost factor (work factor)
BCRYPT_SALT_ROUNDS=10

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
